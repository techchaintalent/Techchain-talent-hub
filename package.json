{
  "name": "techchain-talent-hub",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @techchain/db generate",
    "db:push": "pnpm --filter @techchain/db push",
    "db:migrate": "pnpm --filter @techchain/db migrate",
    "db:seed": "pnpm --filter @techchain/db seed",
    "db:studio": "pnpm --filter @techchain/db studio",
    "worker": "pnpm --filter @techchain/worker start",
    "worker:dev": "pnpm --filter @techchain/worker dev",
    "smoke-test": "./infra/scripts/smoke-test.sh",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": "14.2.35"
    }
  }
}
