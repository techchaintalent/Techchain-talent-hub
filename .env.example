# Development Mode
DEV_MODE=true

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techchain?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_SECRET="this-is-a-secret-key-for-development-only-123"
NEXTAUTH_URL="http://localhost:3000"

# Email (not needed in DEV_MODE)
RESEND_API_KEY=""
EMAIL_FROM="TechChain <noreply@example.com>"

# Payments (not needed in DEV_MODE)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI (using mock in DEV_MODE)
AI_PROVIDER="mock"
OPENAI_API_KEY=""

# Platform
DEFAULT_TAKE_RATE=15
PAYMENT_DELAY_DAYS=14
