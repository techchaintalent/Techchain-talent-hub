# ===========================================
# TechChain Talent Hub - Environment Variables
# ===========================================

# Development Mode - Set to true for local testing without external services
DEV_MODE=true

# ===========================================
# Database (Required)
# ===========================================
# PostgreSQL connection string (with pgvector extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techchain?schema=public"

# Redis connection for BullMQ
REDIS_URL="redis://localhost:6379"

# ===========================================
# Authentication (Required)
# ===========================================
# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# Email (Required in production)
# ===========================================
# Resend API key - get from https://resend.com/api-keys
RESEND_API_KEY=""
# Email sender address (must be verified in Resend)
EMAIL_FROM="TechChain Talent Hub <noreply@yourdomain.com>"

# ===========================================
# Payments (Required in production)
# ===========================================
# Stripe keys - get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Connect settings
STRIPE_CONNECT_CLIENT_ID=""

# ===========================================
# File Storage (Required)
# ===========================================
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # Leave empty for AWS S3, or set for R2/MinIO

# Or use UploadThing (alternative)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ===========================================
# AI Providers (Required for assessments)
# ===========================================
# OpenAI - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"

# Or Anthropic (alternative)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-sonnet-20240229"

# AI Provider selection: "openai" | "anthropic" | "mock"
AI_PROVIDER="mock"

# ===========================================
# GitHub Integration (Optional)
# ===========================================
# GitHub personal access token for public repo analysis
# Create at: https://github.com/settings/tokens (only needs public_repo scope)
GITHUB_TOKEN=""

# ===========================================
# Platform Configuration
# ===========================================
# Default platform take rate (percentage, e.g., 15 for 15%)
DEFAULT_TAKE_RATE=15

# Payment collection delay in days after candidate start date
PAYMENT_DELAY_DAYS=14

# Feature Flags
FEATURE_PHONE_VERIFICATION=false
FEATURE_CANDIDATE_DISCOVERY=true
FEATURE_COMPANY_CANDIDATE_BROWSE=false

# ===========================================
# Security
# ===========================================
# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Session duration in seconds (default: 7 days)
SESSION_MAX_AGE=604800

# ===========================================
# URLs (Production)
# ===========================================
# Base URL of the application
APP_URL="http://localhost:3000"

# Webhook endpoints (for Stripe)
STRIPE_WEBHOOK_ENDPOINT="/api/webhooks/stripe"
